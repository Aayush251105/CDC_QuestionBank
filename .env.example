# Copy to .env and fill in. Never commit .env.

# Pooled Postgres URL used by the app (Neon: host contains "-pooler")
DATABASE_URL=
# Direct URL used by Prisma migrations (Neon: same host without "-pooler")
DIRECT_URL=

# Auth.js: generate with `pnpm dlx auth secret`
AUTH_SECRET=
# Needed only to run a production build locally (`pnpm build && pnpm start`).
# Vercel sets this up by itself.
# AUTH_TRUST_HOST=true
# Only emails on these domains can sign in (comma-separated; to be confirmed
# by the CDC). Empty = nobody can sign in.
ALLOWED_EMAIL_DOMAINS=snu.edu.in

# Google (interim sign-in, CLAUDE.md 2a.7). Shown only when the id is set.
# Only Google-verified emails on ALLOWED_EMAIL_DOMAINS get in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (after SNU IT registers the app). Shown only when the id is set.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# SNU tenant id. Empty = any Microsoft account (still email-checked); production
# then refuses all Microsoft sign-ins unless ALLOW_ANY_MICROSOFT_TENANT=true.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
ALLOW_ANY_MICROSOFT_TENANT=false
# Dev-only seeded-user login; ignored outside `pnpm dev`
DEV_LOGIN=false

# AI (CLAUDE.md 2a.10): Groq, free API. Key from https://console.groq.com/keys
# Empty key = local stub (no AI; the flow still works).
GROQ_API_KEY=
# Text model: splits, classifies and tidies questions (strict JSON output)
AI_MODEL=openai/gpt-oss-120b
# Reads photos of rough sheets (a preview model on Groq; images only)
AI_VISION_MODEL=qwen/qwen3.8-27b

# Photo upload limits: pages per submission, MB per submission, pages per
# student per day
UPLOAD_MAX_PAGES=10
UPLOAD_MAX_MB=15
UPLOAD_DAILY_CAP=30
