# Copy to .env and fill in. Never commit .env.

# Postgres connection string (local or hosted, e.g. Neon on Vercel)
DATABASE_URL=

# Auth.js: generate with `pnpm dlx auth secret`
AUTH_SECRET=
# Microsoft Entra ID app registration (from SNU IT)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Comma-separated; still to be confirmed by the CDC
ALLOWED_EMAIL_DOMAINS=snu.edu.in
# Dev-only seeded-user login; ignored outside `pnpm dev`
DEV_LOGIN=false

# AI (scan reading, cleanup, tagging). Empty key = local stub.
ANTHROPIC_API_KEY=
AI_MODEL=

# Scan upload limits
UPLOAD_MAX_PAGES=10
UPLOAD_MAX_MB=15
UPLOAD_DAILY_CAP=
