// Data model for the CDC Placement Question Bank (CLAUDE.md sections 2a and 6).
// Everything centres on the Drive: one company's hiring cycle in one year.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- People ----------

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  entraOid        String?  @unique // Microsoft object id, set on first SSO sign-in
  rollNo          String?
  programme       String? // e.g. "B.Tech"
  branch          String? // e.g. "CSE"
  gradYear        Int?
  role            Role     @default(STUDENT)
  creditByDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions   Submission[]
  bookmarks     Bookmark[]
  notifications Notification[]
  pinAttempts   PinAttempt[]
  reviewActions ReviewAction[]
  drivesCreated Drive[]        @relation("DriveCreatedBy")
}

// ---------- Companies, drives, rounds ----------

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sector    String?
  aliases   String[]
  hidden    Boolean  @default(false) // CDC can hide a company entirely
  verified  Boolean  @default(true) // false when a student added it via "Drive not listed"
  createdAt DateTime @default(now())

  drives    Drive[]
  bookmarks Bookmark[]
}

enum DriveStatus {
  OPEN
  CLOSED
}

model Drive {
  id          String      @id @default(cuid())
  companyId   String
  year        Int
  name        String // e.g. "SDE intern"; a company can run several drives in a year
  season      String?
  roles       String[]
  ctcBand     String?
  eligibility String?
  status      DriveStatus @default(OPEN)

  // Student-created drives ("Drive not listed") stay unverified until the CDC
  // attaches their submissions to a real drive. Never shown in browse pages.
  verified    Boolean @default(true)
  createdById String?
  createdBy   User?   @relation("DriveCreatedBy", fields: [createdById], references: [id])

  // Generated by the admin side and given only to shortlisted students.
  // Stored normalised (upper case, no spaces). Globally unique, which also
  // covers "unique among open drives".
  submissionPin String?   @unique
  pinCreatedAt  DateTime?
  pinRevokedAt  DateTime?

  createdAt DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id])
  rounds      Round[]
  pinAttempts PinAttempt[]

  @@index([companyId, year])
}

enum RoundType {
  OA
  TECHNICAL
  HR
  GD
}

model Round {
  id          String    @id @default(cuid())
  driveId     String
  order       Int // 1, 2, 3 within the drive
  slug        String // URL segment, unique within the drive
  name        String // "Online assessment", "Bar raiser and HR", ...
  type        RoundType
  date        DateTime?
  format      String? // "2 coding questions and a work style survey"
  platform    String?
  durationMin Int?
  sections    String[]

  drive       Drive                @relation(fields: [driveId], references: [id], onDelete: Cascade)
  questions   Question[]
  appearances QuestionAppearance[]
  submissions Submission[]
  shortlist   ShortlistEntry[]

  @@unique([driveId, slug])
  @@unique([driveId, order])
}

// Admin side fills this from the shortlist CSV. Students never see matches.
model ShortlistEntry {
  id      String  @id @default(cuid())
  roundId String
  rollNo  String?
  email   String?
  name    String?

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

// ---------- Submissions (student side) ----------

enum SubmissionStatus {
  DRAFT
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  NOT_PUBLISHED
  WITHDRAWN
}

enum SubmissionMode {
  FORM
  SCAN
}

enum VerificationTag {
  VERIFIED
  LIKELY
  NOT_FOUND
}

model Submission {
  id               String           @id @default(cuid())
  userId           String
  roundId          String
  role             String? // the role in the drive the student sat for
  enteredWithPin   Boolean          @default(false)
  mode             SubmissionMode   @default(FORM)
  status           SubmissionStatus @default(DRAFT)
  lastStep         String           @default("round") // round | questions | upload | review
  credit           Boolean          @default(false)
  honourAcceptedAt DateTime?
  submittedAt      DateTime?
  reviewStartedAt  DateTime? // once set, the student can no longer edit or withdraw
  reviewedAt       DateTime?
  verificationTag  VerificationTag? // ADMIN ONLY: never select this in student queries
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  round        Round         @relation(fields: [roundId], references: [id])
  scanPages    ScanPage[]
  rawQuestions RawQuestion[]

  // One submission per round: a second visit opens the existing one.
  @@unique([userId, roundId])
  @@index([status])
}

enum ReadStatus {
  READING
  DONE
  UNREADABLE
}

// Text read from one uploaded page. The image itself is never stored.
model ScanPage {
  id            String     @id @default(cuid())
  submissionId  String
  pageNo        Int
  extractedText String?
  readStatus    ReadStatus @default(READING)
  createdAt     DateTime   @default(now()) // also used for the daily upload cap

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, pageNo])
}

enum QuestionType {
  MCQ
  CODING
  APTITUDE
  SQL
  WRITTEN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// A question exactly as a student sent it. Kept after approval.
model RawQuestion {
  id                  String       @id @default(cuid())
  submissionId        String
  order               Int
  section             String?
  type                QuestionType
  title               String?
  textOriginal        String
  textCleaned         String?
  options             Json? // MCQ options: [{ key: "A", text: "..." }]
  suggestedTags       String[]
  suggestedDifficulty Difficulty?
  scanPageNo          Int? // set when read from an upload
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sources    QuestionSource[]

  @@unique([submissionId, order])
}

// ---------- Published questions ----------

model Question {
  id              String       @id @default(cuid())
  roundId         String // the round it is listed under
  order           Int // position in that round
  title           String
  bodyMarkdown    String
  type            QuestionType
  options         Json?
  difficulty      Difficulty
  notes           String? // "From the students who sat it: ..."
  publishedAt     DateTime     @default(now())
  creditedUserIds String[] // only students who opted in to credit

  round       Round                @relation(fields: [roundId], references: [id])
  appearances QuestionAppearance[]
  tags        QuestionTag[]
  sources     QuestionSource[]
  bookmarks   Bookmark[]

  @@unique([roundId, order])
}

// "Where it was asked": other rounds where the same question came up.
model QuestionAppearance {
  questionId String
  roundId    String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  round    Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@id([questionId, roundId])
}

// Links a published question to every raw submission it came from (merged duplicates).
model QuestionSource {
  questionId    String
  rawQuestionId String

  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rawQuestion RawQuestion @relation(fields: [rawQuestionId], references: [id], onDelete: Cascade)

  @@id([questionId, rawQuestionId])
}

model Tag {
  id         String        @id @default(cuid())
  name       String        @unique
  slug       String        @unique
  group      String // "Data structures and algorithms", "Aptitude", ...
  groupOrder Int
  questions  QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

// Following a company or saving a question.
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  companyId  String?
  questionId String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@unique([userId, questionId])
}

// In-app only (no emails). Must never reveal a review outcome.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Every PIN try: used for the per-student rate limit and the admin log.
model PinAttempt {
  id        String   @id @default(cuid())
  userId    String
  pinTried  String // normalised input
  driveId   String? // set only when the PIN matched an open drive
  success   Boolean
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  drive Drive? @relation(fields: [driveId], references: [id])

  @@index([userId, createdAt])
}

// ADMIN ONLY audit log. Reasons here must never reach a student response.
model ReviewAction {
  id         String   @id @default(cuid())
  adminId    String
  targetType String // "submission" | "rawQuestion" | "question" | "drive"
  targetId   String
  action     String // approve | edit | merge | reject | attach
  reason     String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId])
}
