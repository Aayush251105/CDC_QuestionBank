// Data model for the CDC Placement Question Bank (CLAUDE.md sections 2a and 6).
// Everything centres on the Drive: one company's hiring cycle in one year.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- People ----------

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  entraOid        String?   @unique // Microsoft object id, set on first SSO sign-in
  rollNo          String?
  programme       String? // e.g. "B.Tech"
  branch          String? // e.g. "CSE"
  gradYear        Int?
  role            Role      @default(STUDENT)
  creditByDefault Boolean   @default(false)
  // Set by an admin (A11). A blocked student can sign in but cannot browse
  // or submit; their pending submissions leave the review queue. The reason
  // is in the audit log only.
  blockedAt       DateTime?
  lastSignInAt    DateTime? // null = added as an admin but never signed in
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  submissions      Submission[]
  bookmarks        Bookmark[]
  notifications    Notification[]
  pinAttempts      PinAttempt[]
  reviewActions    ReviewAction[]
  drivesCreated    Drive[]           @relation("DriveCreatedBy")
  shortlistUploads ShortlistUpload[]
  shortlistMatches ShortlistEntry[]
  settingsChanged  Setting[]
}

// ---------- Companies, drives, rounds ----------

model Company {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  sector       String?
  aliases      String[]
  hidden       Boolean  @default(false) // CDC can hide a company entirely
  verified     Boolean  @default(true) // false when a student added it via "Drive not listed"
  // Set when an admin merges this company into another (A10). Its drives,
  // aliases and follows move there and this row stays hidden.
  mergedIntoId String?
  createdAt    DateTime @default(now())

  mergedInto Company?   @relation("CompanyMerge", fields: [mergedIntoId], references: [id])
  mergedFrom Company[]  @relation("CompanyMerge")
  drives     Drive[]
  bookmarks  Bookmark[]
}

enum DriveStatus {
  DRAFT // set up by an admin, no rounds yet; hidden from students
  OPEN
  CLOSED
}

model Drive {
  id          String      @id @default(cuid())
  companyId   String
  year        Int
  // A drive is one visit. Usually one per company and year; a second visit in
  // the same year gets sequence 2 and shows as "2025 · B" (src/lib/drives.ts).
  sequence    Int         @default(1)
  name        String? // optional label, e.g. "Off-campus drive"
  season      String?
  roles       String[] // every role hired for in this drive
  ctcBand     String?
  eligibility String?
  status      DriveStatus @default(OPEN)

  // Student-created drives ("Drive not listed") stay unverified until the CDC
  // attaches their submissions to a real drive. Never shown in browse pages.
  verified          Boolean   @default(true)
  createdById       String?
  createdBy         User?     @relation("DriveCreatedBy", fields: [createdById], references: [id])
  // A student-created drive is a "drive request" on the admin side (A02)
  // until an admin attaches its submissions to a real drive or declines it.
  requestResolvedAt DateTime?

  // Submission window (A03). Empty = no limit on that side.
  opensAt  DateTime?
  closesAt DateTime?

  // Generated by the admin side and given only to shortlisted students.
  // Exactly 6 digits (CHECK constraint in the migration), shown as "482 915".
  // Globally unique, so switching a PIN back on can never clash.
  // A PIN opens its drive only while status = OPEN, pinEnabled = true and
  // today is inside the window (src/lib/pin.ts pinOpensDrive).
  // requirePin off = an older drive run without PINs.
  requirePin    Boolean   @default(true)
  submissionPin String?   @unique @db.Char(6)
  pinEnabled    Boolean   @default(true)
  pinCreatedAt  DateTime?

  createdAt DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id])
  rounds      Round[]
  pinAttempts PinAttempt[]

  @@unique([companyId, year, sequence])
}

enum RoundType {
  OA
  TECHNICAL
  HR
  GD
}

model Round {
  id          String    @id @default(cuid())
  driveId     String
  order       Int // 1, 2, 3 within the drive
  slug        String // URL segment, unique within the drive
  name        String // "Online assessment", "Bar raiser and HR", ...
  type        RoundType
  date        DateTime?
  format      String? // "2 coding questions and a work style survey"
  platform    String?
  durationMin Int?
  sections    String[]
  roles       String[] // only these roles sat this round; empty = every role in the drive

  drive            Drive                @relation(fields: [driveId], references: [id], onDelete: Cascade)
  questions        Question[]
  appearances      QuestionAppearance[]
  submissions      Submission[]
  shortlist        ShortlistEntry[]
  shortlistUploads ShortlistUpload[]

  @@unique([driveId, slug])
  @@unique([driveId, order])
}

// One shortlist CSV upload for one round (A06). The file itself is read in
// memory and dropped; only its rows are kept. The newest upload of a round is
// that round's shortlist; older ones stay for "Earlier uploads".
model ShortlistUpload {
  id           String   @id @default(cuid())
  roundId      String
  fileName     String
  uploadedById String
  createdAt    DateTime @default(now())

  round      Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  uploadedBy User             @relation(fields: [uploadedById], references: [id])
  entries    ShortlistEntry[]

  @@index([roundId, createdAt])
}

enum ShortlistMatch {
  ROLL_NO
  EMAIL
  NAME // name only: shows as "Likely" in review
  NONE
}

// One row of a shortlist CSV. Students never see matches.
model ShortlistEntry {
  id            String         @id @default(cuid())
  uploadId      String
  roundId       String
  rowNo         Int // row in the file, for "Row 12 of the round 2 list"
  rollNo        String?
  email         String?
  name          String?
  matchedUserId String?
  match         ShortlistMatch @default(NONE)

  upload      ShortlistUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  round       Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  matchedUser User?           @relation(fields: [matchedUserId], references: [id])

  @@index([roundId])
  @@index([uploadId])
}

// ---------- Submissions (student side) ----------

enum SubmissionStatus {
  DRAFT
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  NOT_PUBLISHED
  WITHDRAWN
}

enum SubmissionMode {
  FORM
  SCAN
}

enum VerificationTag {
  VERIFIED
  LIKELY
  NOT_FOUND
}

model Submission {
  id               String           @id @default(cuid())
  userId           String
  roundId          String
  role             String? // the role in the drive the student sat for
  enteredWithPin   Boolean          @default(false)
  pinUsed          String?          @db.Char(6) // ADMIN ONLY: the PIN it came in with, kept after a regenerate
  mode             SubmissionMode   @default(FORM)
  status           SubmissionStatus @default(DRAFT)
  lastStep         String           @default("round") // round | questions | upload | review
  credit           Boolean          @default(false)
  honourAcceptedAt DateTime?
  submittedAt      DateTime?
  reviewStartedAt  DateTime? // once set, the student can no longer edit or withdraw
  reviewedAt       DateTime?
  verificationTag  VerificationTag? // ADMIN ONLY: never select this in student queries
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  round        Round         @relation(fields: [roundId], references: [id])
  scanPages    ScanPage[]
  rawQuestions RawQuestion[]

  // One submission per round: a second visit opens the existing one.
  @@unique([userId, roundId])
  @@index([status])
}

enum ReadStatus {
  READING
  DONE
  UNREADABLE
}

// Text read from one uploaded page. The image itself is never stored.
model ScanPage {
  id            String     @id @default(cuid())
  submissionId  String
  pageNo        Int
  extractedText String?
  readStatus    ReadStatus @default(READING)
  createdAt     DateTime   @default(now()) // also used for the daily upload cap

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, pageNo])
}

enum QuestionType {
  MCQ
  CODING
  APTITUDE
  SQL
  WRITTEN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ADMIN ONLY: what a reviewer decided for one raw question (A08). Never
// select it in student queries; the reject reason lives in ReviewAction.
enum ReviewDecision {
  APPROVED // published as a new question
  MERGED // added as a source of an existing question
  REJECTED
}

// A question exactly as a student sent it. Kept after approval.
model RawQuestion {
  id                  String          @id @default(cuid())
  submissionId        String
  order               Int
  section             String?
  type                QuestionType
  title               String?
  textOriginal        String
  textCleaned         String?
  options             Json? // MCQ options: [{ key: "A", text: "..." }]
  suggestedTags       String[]
  suggestedDifficulty Difficulty?
  scanPageNo          Int? // set when read from an upload
  decision            ReviewDecision? // ADMIN ONLY
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sources    QuestionSource[]

  @@unique([submissionId, order])
}

// ---------- Published questions ----------

model Question {
  id              String       @id @default(cuid())
  roundId         String // the round it is listed under
  order           Int // position in that round
  title           String
  bodyMarkdown    String
  type            QuestionType
  options         Json?
  difficulty      Difficulty
  notes           String? // "From the students who sat it: ..."
  publishedAt     DateTime     @default(now())
  unpublishedAt   DateTime? // set by an admin (A09); hidden from students while set
  updatedAt       DateTime     @default(now()) @updatedAt
  creditedUserIds String[] // only students who opted in to credit

  round       Round                @relation(fields: [roundId], references: [id])
  appearances QuestionAppearance[]
  tags        QuestionTag[]
  sources     QuestionSource[]
  bookmarks   Bookmark[]

  @@unique([roundId, order])
}

// "Where it was asked": other rounds where the same question came up.
model QuestionAppearance {
  questionId String
  roundId    String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  round    Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@id([questionId, roundId])
}

// Links a published question to every raw submission it came from (merged duplicates).
model QuestionSource {
  questionId    String
  rawQuestionId String

  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rawQuestion RawQuestion @relation(fields: [rawQuestionId], references: [id], onDelete: Cascade)

  @@id([questionId, rawQuestionId])
}

model Tag {
  id         String        @id @default(cuid())
  name       String        @unique
  slug       String        @unique
  group      String // "Data structures and algorithms", "Aptitude", ...
  groupOrder Int
  questions  QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

// Following a company or saving a question.
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  companyId  String?
  questionId String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@unique([userId, questionId])
}

// In-app only (no emails). Must never reveal a review outcome.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Every PIN try: used for the per-student rate limit and the admin log.
model PinAttempt {
  id        String   @id @default(cuid())
  userId    String
  pinTried  String // what the student typed, digits only
  driveId   String? // set when the PIN belongs to a drive, even if the drive refused it
  success   Boolean
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  drive Drive? @relation(fields: [driveId], references: [id])

  @@index([userId, createdAt])
}

// ADMIN ONLY audit log (A14): every approval, edit, rejection, PIN action,
// shortlist upload, block and role or setting change. Rows are only ever
// added, never edited or deleted. Reasons here must never reach a student
// response. Action names live in src/lib/audit.ts.
model ReviewAction {
  id         String   @id @default(cuid())
  adminId    String
  targetType String // "submission" | "rawQuestion" | "question" | "drive" | "round" | "company" | "user" | "setting"
  targetId   String
  action     String
  driveId    String? // the drive it concerns, for the drive filter and Recent activity
  summary    String? // what it was done to, as shown in the "On" column
  detail     String? // what changed, as shown in the "Detail" column
  reason     String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId])
  @@index([driveId, createdAt])
  @@index([createdAt])
}

// Super admin switches and defaults (A13). Sign-in tenant and email domains
// stay in env and are only shown, never edited here (CLAUDE.md section 10).
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])
}
